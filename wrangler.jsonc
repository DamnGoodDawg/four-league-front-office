{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "four-league-front-office",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Fires every 2 minutes; the handler decides depth: full sync each tick
  // during ET game windows (Thu/Mon eve, Sun afternoon+), every 10 min
  // otherwise, waiver/trending refresh at 6:00 and 18:00 ET.
  "triggers": { "crons": ["*/2 * * * *"] },
  // Non-secret vars only. League IDs, team IDs, cookies, and the dashboard
  // token are secrets (wrangler secret put / .dev.vars) — this file is public.
  "vars": {
    "ESPN_SEASON": "2026"
  },
  // Public static assets (PWA manifest + icons only — nothing sensitive).
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "four-league-db",
      "database_id": "04157bb1-50b8-4041-b7a8-66a0caef9edf",
      "migrations_dir": "./migrations"
    }
  ]
}
