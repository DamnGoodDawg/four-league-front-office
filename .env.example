# ── Copy me: `cp .env.example .env` — then fill in .env (gitignored, stays on this Mac).
# Never paste these values into chat, commits, or logs.

# ── ESPN (one cookie pair covers all three leagues) ─────────────────────────
# From a logged-in fantasy.espn.com session → Web Inspector → Storage → Cookies.
# espn_s2 is ~250+ characters — copy ALL of it. SWID includes the curly braces.
ESPN_S2=
ESPN_SWID={}

# Comma-separated leagueId values from the three ESPN league URLs (not secret),
# with my teamId in each league, aligned by position.
ESPN_LEAGUE_IDS=
ESPN_TEAM_IDS=
ESPN_SEASON=2026

# ── Yahoo — interim session-cookie path (until the official API is approved) ─
# The number from https://football.fantasysports.yahoo.com/f1/<number>
YAHOO_LEAGUE_ID=
# Full Cookie header from a logged-in football.fantasysports.yahoo.com request
# (Network tab -> Doc -> top request -> Request Headers -> Cookie). Must contain
# A1=, A3=, T=. Long-lived but re-grab when the dashboard flags it expired.
YAHOO_COOKIE=
# My team number (from my team URL /f1/<league>/<n>); optional — auto-discovered.
YAHOO_TEAM_ID=

# ── Yahoo — official API (fill in once the access application is approved) ────
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
